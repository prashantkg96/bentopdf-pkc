    {
      "id": "docs_getting_started_coopcoeprequirement",
      "label": "COOP/COEP SharedArrayBuffer Requirement",
      "file_type": "rationale",
      "source_file": "docs/getting-started.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Office file conversion needs SharedArrayBuffer, which requires Cross-Origin-Opener-Policy: same-origin, Cross-Origin-Embedder-Policy: require-corp, and a secure context. localhost is treated as trustworthy by browsers so it works over plain HTTP for local testing, but LAN IPs (e.g. 192.168.x.x) usually are not, so Word/Excel/PowerPoint conversions require HTTPS when the self-hosted deployment is accessed from other devices on the network."
    },
