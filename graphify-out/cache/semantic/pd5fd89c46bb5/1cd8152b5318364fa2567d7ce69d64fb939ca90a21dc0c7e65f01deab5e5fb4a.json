    {
      "id": "readme_privacy_first_architecture",
      "label": "Client-Side-Only Privacy Architecture",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "All PDF processing runs client-side (WASM/JS) so files never leave the device; the analytics ping deliberately excludes file names/contents to preserve this guarantee even in telemetry."
    },
    {
      "id": "readme_pkc_rebranding",
      "label": "PKC Rebranding of BentoPDF",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "This fork intentionally rebrands BentoPDF to 'PKC PDF Tools' (theme, shared nav/footer, per-tool header), builds in SIMPLE_MODE with a fixed BASE_URL, and strips the Office-conversion/LibreOffice-WASM feature plus non-English locales to fit Cloudflare's 25 MiB per-asset limit, while leaving the underlying PDF engine unchanged from upstream."
    },
