    {
      "id": "docs_self_hosting_apache_mjs_mime_fix",
      "label": ".mjs MIME Type Fix (Apache)",
      "file_type": "rationale",
      "source_file": "docs/self-hosting/apache.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Apache's stock mime.types doesn't map .mjs to application/javascript by default, causing the bundled ES-module PDF viewer (Sign PDF, Form Filler) to fail strict MIME checking; fixed by adding AddType application/javascript .mjs."
    },
    {
      "id": "docs_self_hosting_apache_sharedarraybuffer_headers",
      "label": "SharedArrayBuffer Headers (Apache)",
      "file_type": "rationale",
      "source_file": "docs/self-hosting/apache.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "LibreOffice WASM (Word/ODT/Excel conversion) requires SharedArrayBuffer, which needs COEP/COOP headers plus a secure context; LAN IP HTTP origins don't count as secure even with headers present."
    },
